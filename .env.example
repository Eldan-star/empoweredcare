# Copy to .env and fill in. Never commit .env.

# "development" allows a throwaway per-process secret; anything else requires SECRET_KEY.
APP_ENV=development
SECRET_KEY=

# Comma-separated list of frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# PostgreSQL connection (see docs/DATABASE_SETUP.md). Change the password for anything shared.
DATABASE_URL=postgresql+psycopg://empoweredcare:empoweredcare@localhost:5432/empoweredcare

# Language model for text agents: gemini (default) or claude.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Gemini models to try, in order (comma-separated). Update when Google retires one;
# `python list_models.py` lists what your key can use.
GEMINI_MODELS=gemini-3.8-flash
# Requests per minute allowed per model; 0 = no pacing. On the free tier use the lowest
# RPM shown for your models at https://ai.dev/rate-limit (e.g. 5).
GEMINI_RPM=0
# Longest one AI call may take, including waits, before the app gives up (seconds).
GEMINI_CALL_BUDGET_SECONDS=60
# Only when LLM_PROVIDER=claude (pip install anthropic):
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# DHIS2 (docs/DHIS2.md). The public demo needs no approval; any other server needs
# DHIS2_PULL_APPROVED=true, set only after the data owner (EPHI) approves in writing.
DHIS2_URL=
DHIS2_TOKEN=
# or DHIS2_USERNAME= and DHIS2_PASSWORD=
DHIS2_PULL_APPROVED=false

# Scraping Google/Bing result pages for location context; off by default.
ENABLE_WEB_RESEARCH=false
MAX_TEXT_LENGTH=20000

# Email (invitations and password resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=http://localhost:8080
